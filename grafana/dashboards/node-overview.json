        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\", instance=~\"$instance\"}",
