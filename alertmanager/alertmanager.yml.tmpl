# Alertmanager configuration template.
#
# Rendered at container start by alertmanager/entrypoint.sh, which replaces only
# ${SLACK_WEBHOOK_URL} and ${SLACK_CHANNEL}. Everything else is passed through
# unchanged. Validate with "make validate" or "docker compose run --rm alertmanager check".

global:
  resolve_timeout: 5m
  slack_api_url: "${SLACK_WEBHOOK_URL}"

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: slack-warning
  group_by: [alertname, job, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Watchdog fires all the time so a silent pipeline is noticed. It goes to the
    # null receiver here; point a dead man's switch at it if you want paging.
    - receiver: "null"
      matchers:
        - alertname = Watchdog
    - receiver: slack-critical
      matchers:
        - severity = critical
      group_wait: 15s
      repeat_interval: 1h
    - receiver: slack-warning
      matchers:
        - severity = warning
    - receiver: slack-info
      matchers:
        - severity = info
      repeat_interval: 24h

inhibit_rules:
  # A critical alert mutes the warning version of the same alert on the same
  # target, for example the 3 day certificate expiry over the 30 day one.
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: [alertname, instance]
  # An unreachable host produces nothing else worth reading.
  - source_matchers:
      - alertname = NodeExporterDown
    target_matchers:
      - severity =~ "warning|info"
    equal: [instance]

receivers:
  - name: "null"

  - name: slack-critical
    slack_configs:
      - channel: "${SLACK_CHANNEL}"
        send_resolved: true
        username: Alertmanager
        color: '{{ template "slack.color" . }}'
        title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'

  - name: slack-warning
    slack_configs:
      - channel: "${SLACK_CHANNEL}"
        send_resolved: true
        username: Alertmanager
        color: '{{ template "slack.color" . }}'
        title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'

  - name: slack-info
    slack_configs:
      - channel: "${SLACK_CHANNEL}"
        send_resolved: false
        username: Alertmanager
        color: '{{ template "slack.color" . }}'
        title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'
