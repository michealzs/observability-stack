# Copy to .env and fill in real values. .env is git-ignored.

# Grafana admin login (anonymous access and sign-up are disabled).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-first-start

# URL users open Grafana on. Used for links in Grafana emails and redirects.
GRAFANA_ROOT_URL=http://localhost:3000

# Slack incoming webhook for Alertmanager. Create one under
# https://api.slack.com/apps -> Incoming Webhooks. The value below is a placeholder.
SLACK_WEBHOOK_URL=https://hooks.slack.example/services/REPLACE/WITH/YOUR-WEBHOOK-PATH
SLACK_CHANNEL="#alerts"

# Prometheus TSDB retention (30d default; 15d on hosts with little disk).
PROM_RETENTION=30d

# Alertmanager external URL, used in Slack "source" links.
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# Label Promtail attaches to /var/log entries from the monitoring host.
HOST_LABEL=monitoring-host

# Container timezone.
TZ=UTC
